<?xml version='1.0' encoding='utf-8'?>
<widget id="ma.education.absencereader" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>قارئ بطاقات الغياب</name>
    <description>تطبيق الحراسة العامة لحساب ساعات غياب المتعلمين</description>
    <author email="admin@education.ma">الحراسة العامة</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <preference name="Orientation" value="portrait" />
    <preference name="AndroidPersistentFileLocation" value="Compatibility" />
    <platform name="android">
        <preference name="AndroidTargetSdkVersion" value="34" />
        <preference name="AndroidMinSdkVersion" value="24" />
    </platform>
</widget>
